{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "popup",
    "toast"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.pathofexile.com/*"
        },
        {
          "url": "https://ru.pathofexile.com/*"
        },
        {
          "url": "https://poe.ninja/*"
        }
      ]
    },
    "opener:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
  ]
}