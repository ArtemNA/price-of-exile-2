/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    // Off for ported EE2 code (src/lib/ee2), which is kept identical to upstream
    // and is written against plain `strict` without these two checks.
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    // EE2 code uses ES2023 `toSorted` and ES2025 Set methods (WebView2 and Node 22+ have them).
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "preserve",
    // Ported EE2 code keeps its original imports (`@/` = EE2 renderer/src), so upstream files can be
    // copied over as-is. EE2 modules we replace with our own code live in src/app/ee2-shims.
    // Same aliases in vitest.config.mts.
    "paths": {
      "@/web/Config": ["./src/app/ee2-shims/web-config"],
      "@/web/background/IPC": ["./src/app/ee2-shims/ipc"],
      "@/web/background/Prices": ["./src/app/ee2-shims/prices"],
      "@/web/background/TradeData": ["./src/app/ee2-shims/trade-data"],
      "@/web/overlay/interfaces": ["./src/app/ee2-shims/overlay-interfaces"],
      "@/*": ["./src/lib/ee2/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
